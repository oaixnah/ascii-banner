# Required public production origin. Use HTTPS and do not include a path.
SITE_URL=https://asciibanner.dev

# Required at build time. This address is rendered into the public Contact pages.
CONTACT_EMAIL=contact@example.com

# Required analytics identifiers. They become public in the generated HTML.
GA_MEASUREMENT_ID=G-ABCD123456
CLARITY_PROJECT_ID=abcde12345

# Keep advertising disabled until a consent flow and real provider are configured.
PUBLIC_ADS_ENABLED=false
